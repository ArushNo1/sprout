# Copy to web/.env.local for local dev; set the same names in Vercel > Project Settings > Environment Variables.
# Server-side only (never prefixed NEXT_PUBLIC_): the token can write, so it must not reach the browser.
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DB=sprout-db
SPACETIMEDB_TOKEN=

# Client-side (browser): used by the live-game WebSocket connection.
NEXT_PUBLIC_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB=sprout-0gz5d
