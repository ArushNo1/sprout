# Copy this file to uagents-python/.env and fill in the values.
# Never commit .env; it holds secrets. Both agents in this folder read it.

# --- Sprout agent (agent.py) ---
# Long secret phrase. It fixes the agent's address, so keep it the same across runs.
AGENT_SEED=
AGENT_NAME=sprout
AGENT_PORT=8000

# --- Curriculum agent (curriculum/agent.py) ---
# ASI:One API key from https://asi1.ai/developer (ask Pranav for the team key).
ASI_ONE_API_KEY=
# Long secret phrase, different from AGENT_SEED. Fixes the curriculum agent's address when run locally.
CURRICULUM_SEED=
# Optional: asi1-mini (default, faster) or asi1
# ASI_ONE_MODEL=asi1-mini
# Optional: card image server
# SPROUT_CARDS_URL=https://sprout-cards-six.vercel.app

# --- Store agent (store/agent.py) ---
# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys (no real money moves).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Long secret phrase, different from the others. Fixes the store agent's address when run locally.
STORE_SEED=
# Optional: which agent to ask for course maps (defaults to the hosted Sprout Curriculum agent)
# CURRICULUM_ADDRESS=agent1qtddszc00qe3jgkpsu652wvp0nm4j4tywcpjt554ct5acn09gs3lu3nk8nh
