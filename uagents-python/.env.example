# Copy this file to uagents-python/.env and fill in the values.
# Never commit .env; it holds secrets. Both agents in this folder read it.

# --- Sprout agent (agent.py) ---
# Long secret phrase. It fixes the agent's address, so keep it the same across runs.
AGENT_SEED=
AGENT_NAME=sprout
AGENT_PORT=8000

# --- Curriculum agent (curriculum/agent.py) ---
# ASI:One API key from https://asi1.ai/developer (ask Pranav for the team key).
ASI_ONE_API_KEY=
# Long secret phrase, different from AGENT_SEED. Fixes the curriculum agent's address when run locally.
CURRICULUM_SEED=
# Optional: asi1-mini (default, faster) or asi1
# ASI_ONE_MODEL=asi1-mini
# Optional: card image server
# SPROUT_CARDS_URL=https://sprout-cards-six.vercel.app
# SpacetimeDB (shared learner/course database, see ../spacetimedb/API.md).
# Used to tell a new user from a returning one on first contact. Without it,
# the curriculum agent logs a warning and skips onboarding (no crash).
# Optional: defaults to a local dev server and the deployed "sprout-0gz5d" database.
# SPACETIMEDB_HOST=http://127.0.0.1:3000
# SPACETIMEDB_DB_NAME=sprout-0gz5d
# An agent token registered via `register_agent`, or the database owner's
# token (`spacetime login show --token`) while developing.
SPACETIMEDB_TOKEN=

# --- Orchestrator (orchestrator/agent.py): the agent students talk to ---
# Long secret phrase. Fixes the orchestrator's address.
ORCHESTRATOR_SEED=
# Specialists it routes to. The curriculum default is the hosted Sprout Curriculum agent.
# CURRICULUM_ADDRESS=agent1qtddszc00qe3jgkpsu652wvp0nm4j4tywcpjt554ct5acn09gs3lu3nk8nh
TUTOR_ADDRESS=
# Specialists only accept relayed student turns from these orchestrator addresses (comma-separated).
TRUSTED_ORCHESTRATORS=

# --- Tutor agent (tutor/agent.py) ---
# Long secret phrase, different from the others. Fixes the tutor's address when run locally.
TUTOR_SEED=
# Optional: how the tutor points students to the Curriculum agent
# CURRICULUM_HANDLE=@blank-agent-181

# --- Shared SpacetimeDB database (all agents; see sprout_db.py and spacetimedb/API.md) ---
# Default host is Maincloud. For a local test server use http://127.0.0.1:3000.
# SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=sprout-live
# Token of the database owner or a registered agent (ask Arush). Without it agents skip the database.
SPACETIMEDB_TOKEN=
