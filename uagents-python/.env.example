# Copy this file to uagents-python/.env and fill in the values. Never commit .env.
# Run the agents from uagents-python/: python -m orchestrator.agent (or tutor.agent, curriculum.agent).

# --- Shared by all agents ---
# ASI:One API key from https://asi1.ai/developer (ask Pranav for the team key).
ASI_ONE_API_KEY=
# Shared SpacetimeDB database (see sprout_db.py and ../spacetimedb/API.md).
# Default host is Maincloud; for a local server use http://127.0.0.1:3000.
# SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_DB=sprout-live
# Token of a registered agent (the owner registers it with the register_agent reducer; ask Arush).
# Without it the agents skip the database.
SPACETIMEDB_TOKEN=
# Only for deploy_hosted.py: agentverse.ai > Profile > API Keys.
# AGENTVERSE_API_KEY=
# Optional
# ASI_ONE_MODEL=asi1-mini
# SPROUT_CARDS_URL=https://sprout-cards-six.vercel.app
# SPROUT_WEB_URL=https://sproutlearn.tech

# --- Sprout (orchestrator/agent.py): the agent students talk to ---
# Long secret phrase. It fixes the agent's address, so keep it the same across runs.
ORCHESTRATOR_SEED=
# 1 (default) runs the tutor and curriculum in-process; 0 relays to the hosted specialists below.
# SPROUT_IN_PROCESS=1
# CURRICULUM_ADDRESS=agent1qtddszc00qe3jgkpsu652wvp0nm4j4tywcpjt554ct5acn09gs3lu3nk8nh
# TUTOR_ADDRESS=agent1qfd9vn03a5udss62gpl9nag9r6qljz9td0ngmrdfzea70csvk04hwpc5upy
# ARCADE_ADDRESS=agent1qdvszkqcf6xz6frmegrtk95uymzayfvdcu7m8cpuajjr3vyj5zqlsxwj6dz
# GARDEN_ADDRESS=agent1qwxlahz0xv67shp4eawqh76f5le7u5hqy9tkafntaz9d4w0es07jjdary93

# --- Standalone specialists (tutor, curriculum, arcade, garden: python -m <name>.agent) ---
# Long secret phrases, different from each other and from ORCHESTRATOR_SEED.
TUTOR_SEED=
ARCADE_SEED=
GARDEN_SEED=
CURRICULUM_SEED=
# Orchestrator addresses allowed to relay student turns (comma-separated).
TRUSTED_ORCHESTRATORS=
# How the standalone tutor points students to the curriculum agent.
# CURRICULUM_HANDLE=@blank-agent-181
